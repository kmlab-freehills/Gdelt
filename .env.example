# PostgreSQL 接続
DATABASE_URL=postgresql://gdelt_user:gdelt_password@db:5432/gdelt_db
POSTGRES_USER=gdelt_user
POSTGRES_PASSWORD=gdelt_password
POSTGRES_DB=gdelt_db

# LLM
# バックエンド切替: ollama（ローカルLLM） / gemini（未設定時は GEMINI_API_KEY があれば gemini）
LLM_BACKEND=ollama

# Ollama（マシンごとに変更可）
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=300
# Ollama使用時の1回あたり処理件数（Gemini使用時は LLM_BATCH_LIMIT を使う）
OLLAMA_BATCH_LIMIT=100
# 起動時にOllamaの立ち上がりを待つ最大秒数
OLLAMA_STARTUP_WAIT_SECONDS=300

# Gemini（LLM_BACKEND=gemini のとき使用）
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# スケジューラ設定（任意）
# 初回起動時（カーソル未設定）に何分前まで遡ってngramsを取得するか
NGRAMS_BACKFILL_MINUTES=60
# 記事本文の保存上限（文字数）
SCRAPE_TEXT_LIMIT=4000
LLM_INTERVAL_HOURS=6
LLM_BATCH_LIMIT=20

# API サーバー
API_HOST=0.0.0.0
API_PORT=8000
